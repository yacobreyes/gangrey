# Copy to .env.selfhost and fill in. Only NEXTAUTH_* + Google are required.
# Your site's public URL — https://gangrey.org in production, or
# http://localhost:3000 for local dev. Required for sign-in to work.
NEXTAUTH_URL=https://gangrey.org
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_EMAIL=
# Optional — leave empty to run without payments/email:
STRIPE_SECRET_KEY=
# From Stripe Dashboard → Developers → Webhooks → your endpoint's signing secret
# (starts with whsec_). Required for memberships to record on payment.
STRIPE_WEBHOOK_SECRET=
GANGREY_RESEND_KEY=
NEWSLETTER_FROM=
# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Empty = no analytics.
# Baked at build time, so re-run ./deploy.sh after changing it.
NEXT_PUBLIC_GA_ID=

# Scheduled publishing (self-host): any long random string (openssl rand -hex 32).
# Required for scheduled posts to flip live and scheduled newsletters to send.
CRON_SECRET=

# --- Push notifications (optional) -------------------------------------------
# Lets Imago notify your phone about submissions, failed payments, new members
# and scheduled sends. Generate the pair ONCE (new keys unsubscribe every
# device that already opted in):
#   docker run --rm -v "$PWD":/w -w /w node:22-slim node scripts/gen-vapid.mjs
# Empty = the Notifications panel says it isn't set up, and nothing else breaks.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gangrey.org

# --- Offsite backups (optional, strongly recommended) -------------------------
# Continuous replication of the SQLite database to object storage, so the
# recovery point is seconds instead of a night. Empty = no replication and the
# app boots exactly as before. See SELFHOST.md "Backups".
#   e.g. s3://gangrey-backups/imago
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Only for non-AWS S3-compatible storage (Cloudflare R2, Backblaze B2, Hetzner).
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
